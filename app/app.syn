-- Private payroll on Vela. An employer funds the app with a stablecoin and runs pay runs; each
-- person sees only their own payslips; balances, names and amounts never leave the enclave;
-- withdrawals settle on-chain as pull-payments; an allowed authority (an auditor) can ask for
-- the plain picture. This file is the WHOLE application: it is embedded into the guest module
-- (`scripts/build.sh` → build/app.wasm), so the SHA-256 Vela verifies on-chain covers it.
--
-- Entry points (one map in, one map out; see https://synsema.dev/en/0.6.x/73-vela):
--   deploy(ctx)       params {"employer": "0x…", "token"?: "0x…"}  (token defaults to ETH; use a stablecoin)
--   deposit(ctx)      only the app's token; credits the sender (normally the employer funding a run)
--   process(ctx)      {"type": "payrun", "period"?, "items": [{"to", "amount", "memo"?}, …]}   employer only
--                     {"type": "withdraw", "amount", "to"?}                                       anyone with a balance
--   deanonymize(ctx)  {"report_type"?: "balances" | "payslips", "address"?}                      an allowed authority
--
-- Amounts are the token's smallest unit as decimal TEXT (USDC: 6 decimals → "1500500000" is 1500.50).
-- The client converts from human amounts. Deterministic by construction: no clock, no randomness.
-- Test natively before building: `synsema test app/app.syn`.
intent: "vela app: private payroll — an employer pays a list of people, each sees only their payslips"

let ETH be "0x0000000000000000000000000000000000000000"
let MAX_ITEMS be 500
let MAX_PAYSLIPS be 2000

task hex_of(b)
    give "0x" + decode(b, "hex")

task is_address(a)
    give a != nothing and starts_with(lower(text(a)), "0x") and length(text(a)) == 42 and matches(slice(text(a), 2, 42), "[0-9a-fA-F]+")

-- ---- state ----

task new_state(app_id, employer, token)
    give {"app_id": app_id, "employer": employer, "token": token, "balances": {}, "payslips": [], "runs": 0, "nonce": 0}

task balance_of(state, account)
    when contains(state["balances"], account)
        give decimal(state["balances"][account])
    give decimal("0")

task set_balance(state, account, amount)
    let balances be state["balances"]
    set balances[account] to text(amount)
    set state["balances"] to balances
    give state

-- ---- entry points ----

task deploy(ctx)
    let params be ctx["params"]
    when params == nothing or not contains(params, "employer") or not is_address(params["employer"])
        give {"error": "deploy needs constructorParams {\"employer\": \"0x…\", \"token\"?: \"0x…\"}"}
    let token be when contains(params, "token") and params["token"] != nothing and params["token"] != "" then params["token"] otherwise ETH
    when not is_address(token)
        give {"error": "invalid token address " + text(token)}
    give {"state": new_state(ctx["app_id"], lower(params["employer"]), lower(token)), "fuel": "5"}

-- Cache warm-up after an Executor restart; the state returned here is discarded.
task load_module(ctx)
    give {"state": new_state(ctx["app_id"], "", ETH), "fuel": "5"}

task deposit(ctx)
    let state be ctx["state"]
    when lower(ctx["token"]) != state["token"]
        give {"error": "this payroll runs on " + state["token"] + ", not " + lower(ctx["token"])}
    let amount be decimal(ctx["value"])
    let after be balance_of(state, ctx["sender"]) + amount
    let s1 be set_balance(state, ctx["sender"], after)
    set s1["nonce"] to s1["nonce"] + 1
    let event be {"type": "deposit", "amount": ctx["value"], "balance": text(after), "nonce": s1["nonce"]}
    give {"state": s1, "events": [{"user": ctx["sender"], "data": event}], "fuel": "35"}

task process(ctx)
    let payload be ctx["payload"]
    when payload == nothing or not contains(payload, "type")
        give {"error": "payload needs a \"type\": payrun | withdraw"}
    match payload["type"]
        is "payrun"
            give payrun(ctx, ctx["state"], payload)
        is "withdraw"
            give withdraw(ctx, ctx["state"], payload)
        otherwise
            give {"error": "unsupported instruction type: " + text(payload["type"])}

-- One pay run: the employer's balance pays every item; each person gets an encrypted payslip, the
-- employer a summary, and the chain a public receipt (run, count, keccak of the items) that proves
-- the run happened without revealing who or how much.
task payrun(ctx, state, payload)
    when ctx["sender"] != state["employer"]
        give {"error": "only the employer runs payroll"}
    when not contains(payload, "items") or payload["items"] == nothing or length(payload["items"]) == 0
        give {"error": "payrun needs a non-empty \"items\" list"}
    let items be payload["items"]
    when length(items) > MAX_ITEMS
        give {"error": "a pay run takes at most " + text(MAX_ITEMS) + " items"}
    let period be when contains(payload, "period") and payload["period"] != nothing then text(payload["period"]) otherwise ""
    let total be decimal("0")
    each item in items
        when not contains(item, "to") or not is_address(item["to"])
            give {"error": "every item needs a \"to\" address"}
        when not contains(item, "amount") or item["amount"] == nothing
            give {"error": "every item needs an \"amount\""}
        let amount be decimal(text(item["amount"]))
        when amount <= decimal("0")
            give {"error": "amounts must be positive"}
        set total to total + amount
    let available be balance_of(state, state["employer"])
    when available < total
        give {"error": "insufficient funds: the run needs " + text(total) + ", the employer has " + text(available)}
    let run be state["runs"] + 1
    let s1 be set_balance(state, state["employer"], available - total)
    set s1["runs"] to run
    set s1["nonce"] to s1["nonce"] + 1
    let events be []
    let payslips be s1["payslips"]
    each item in items
        let dest be lower(item["to"])
        let amount be decimal(text(item["amount"]))
        let memo be when contains(item, "memo") and item["memo"] != nothing then text(item["memo"]) otherwise ""
        let after be balance_of(s1, dest) + amount
        set s1 to set_balance(s1, dest, after)
        let slip be {"run": run, "period": period, "to": dest, "amount": text(amount), "memo": memo}
        set payslips to append(payslips, slip)
        set events to append(events, {"user": dest, "data": {"type": "payslip", "run": run, "period": period, "amount": text(amount), "memo": memo, "balance": text(after), "nonce": s1["nonce"]}})
    when length(payslips) > MAX_PAYSLIPS
        set payslips to slice(payslips, length(payslips) - MAX_PAYSLIPS, length(payslips))
    set s1["payslips"] to payslips
    set events to append(events, {"user": state["employer"], "data": {"type": "payrun", "run": run, "period": period, "count": length(items), "total": text(total), "balance": text(available - total), "nonce": s1["nonce"]}})
    -- Public receipt: abi.encode(uint256 run, uint256 count, bytes32 keccak(items)). Whoever holds
    -- the items can prove this run paid exactly them; nobody else learns who or how much.
    let call be abi_encode("payrun(uint256,uint256,bytes32)", [run, length(items), keccak256(json_encode(items))])
    let receipt be {"subtype": "payrun", "data_hex": hex_of(slice(call, 4, length(call)))}
    give {"state": s1, "events": events, "app_events": [receipt], "fuel": "60"}

-- {"type": "withdraw", "amount": "<units>", "to"?: "0x…"} → a pull-payment the recipient (or anyone
-- for them) claims on-chain with claim(token, payee). Employees never need ETH: the employer's
-- facilitator submits the request and triggers the claim.
task withdraw(ctx, state, payload)
    when not contains(payload, "amount") or payload["amount"] == nothing
        give {"error": "withdraw needs an \"amount\""}
    let amount be decimal(text(payload["amount"]))
    when amount <= decimal("0")
        give {"error": "amounts must be positive"}
    let dest be when contains(payload, "to") and payload["to"] != nothing and payload["to"] != "" then lower(payload["to"]) otherwise ctx["sender"]
    when not is_address(dest)
        give {"error": "invalid destination address " + text(dest)}
    let available be balance_of(state, ctx["sender"])
    when available < amount
        give {"error": "insufficient balance: " + text(available) + " < " + text(amount)}
    let s1 be set_balance(state, ctx["sender"], available - amount)
    set s1["nonce"] to s1["nonce"] + 1
    let event be {"type": "withdrawal", "to": dest, "amount": text(amount), "balance": text(available - amount), "nonce": s1["nonce"]}
    give {"state": s1, "events": [{"user": ctx["sender"], "data": event}], "withdrawals": [{"token": state["token"], "to": dest, "amount": text(amount)}], "fuel": "50"}

-- Request type 2, for an allowed authority (an auditor): the plain picture, encrypted to them.
task deanonymize(ctx)
    let state be ctx["state"]
    let payload be ctx["payload"]
    let report_type be when payload != nothing and contains(payload, "report_type") and payload["report_type"] != nothing then payload["report_type"] otherwise "balances"
    match report_type
        is "balances"
            give {"report": {"employer": state["employer"], "token": state["token"], "runs": state["runs"], "balances": state["balances"]}, "fuel": "20"}
        is "payslips"
            when payload != nothing and contains(payload, "address") and payload["address"] != nothing
                let addr be lower(payload["address"])
                give {"report": {"address": addr, "payslips": where(state["payslips"], (p) => p["to"] == addr)}, "fuel": "20"}
            give {"report": {"payslips": state["payslips"]}, "fuel": "20"}
        otherwise
            give {"error": "unsupported report type: " + text(report_type)}

-- ---------------------------------------------------------------------------------------
-- Tests: `synsema test app/app.syn`. The same code runs inside the enclave.
-- ---------------------------------------------------------------------------------------

let ACME be "0x1111111111111111111111111111111111111111"
let ANA be "0x2222222222222222222222222222222222222222"
let BEN be "0x3333333333333333333333333333333333333333"
let USDC be "0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48"

task company()
    give deploy({"app_id": 1, "kind": "deploy", "params": {"employer": ACME, "token": USDC}})["state"]

task funded(units)
    give deposit({"app_id": 1, "sender": ACME, "token": USDC, "value": units, "value_hex": "0x0", "state": company()})["state"]

task run_payroll(state, sender, items, period)
    give process({"app_id": 1, "sender": sender, "request_type": 1, "kind": "process", "payload": {"type": "payrun", "period": period, "items": items}, "payload_hex": nothing, "state": state})

test "deploy needs an employer; the token defaults to ETH and is normalized"
    let r be deploy({"app_id": 7, "kind": "deploy", "params": {"employer": "0x1111111111111111111111111111111111111111", "token": "0xA0B86991C6218B36C1D19D4A2E9EB0CE3606EB48"}})
    assert_eq(r["state"]["employer"], ACME)
    assert_eq(r["state"]["token"], USDC)
    assert_eq(deploy({"app_id": 7, "kind": "deploy", "params": {"employer": ACME}})["state"]["token"], ETH)
    assert(starts_with(deploy({"app_id": 7, "kind": "deploy", "params": nothing})["error"], "deploy needs"))
    assert(starts_with(deploy({"app_id": 7, "kind": "deploy", "params": {"employer": "acme"}})["error"], "deploy needs"))

test "deposits are accepted only in the payroll token"
    let ok be deposit({"app_id": 1, "sender": ACME, "token": USDC, "value": "5000000000", "value_hex": "0x0", "state": company()})
    assert_eq(ok["state"]["balances"][ACME], "5000000000")
    let bad be deposit({"app_id": 1, "sender": ACME, "token": ETH, "value": "1", "value_hex": "0x1", "state": company()})
    assert(starts_with(bad["error"], "this payroll runs on"))

test "a pay run pays everyone, one payslip each, a summary for the employer and a public receipt"
    let items be [{"to": ANA, "amount": "1500500000", "memo": "September"}, {"to": BEN, "amount": "2000000000"}]
    let r be run_payroll(funded("5000000000"), ACME, items, "2026-09")
    assert_eq(r["state"]["balances"][ACME], "1499500000")
    assert_eq(r["state"]["balances"][ANA], "1500500000")
    assert_eq(r["state"]["balances"][BEN], "2000000000")
    assert_eq(r["state"]["runs"], 1)
    assert_eq(length(r["events"]), 3)
    assert_eq(r["events"][0]["user"], ANA)
    assert_eq(r["events"][0]["data"]["type"], "payslip")
    assert_eq(r["events"][0]["data"]["memo"], "September")
    assert_eq(r["events"][2]["user"], ACME)
    assert_eq(r["events"][2]["data"]["total"], "3500500000")
    assert_eq(length(r["state"]["payslips"]), 2)
    let receipt be abi_decode("(uint256,uint256,bytes32)", bytes(slice(r["app_events"][0]["data_hex"], 2, length(r["app_events"][0]["data_hex"])), "hex"))
    assert_eq(receipt[0], 1)
    assert_eq(receipt[1], 2)
    assert_eq(receipt[2], keccak256(json_encode(items)))

test "only the employer runs payroll, and never beyond its balance"
    let s be funded("100")
    let intruder be run_payroll(s, ANA, [{"to": BEN, "amount": "1"}], "")
    assert_eq(intruder["error"], "only the employer runs payroll")
    let broke be run_payroll(s, ACME, [{"to": BEN, "amount": "101"}], "")
    assert(starts_with(broke["error"], "insufficient funds"))
    let empty be run_payroll(s, ACME, [], "")
    assert(starts_with(empty["error"], "payrun needs"))
    let zero be run_payroll(s, ACME, [{"to": BEN, "amount": "0"}], "")
    assert_eq(zero["error"], "amounts must be positive")

test "an employee withdraws to a pull-payment in the payroll token"
    let paid be run_payroll(funded("5000000000"), ACME, [{"to": ANA, "amount": "1500500000"}], "2026-09")["state"]
    let r be process({"app_id": 1, "sender": ANA, "request_type": 1, "kind": "process", "payload": {"type": "withdraw", "amount": "500000000"}, "payload_hex": nothing, "state": paid})
    assert_eq(r["state"]["balances"][ANA], "1000500000")
    assert_eq(r["withdrawals"], [{"token": USDC, "to": ANA, "amount": "500000000"}])
    let over be process({"app_id": 1, "sender": ANA, "request_type": 1, "kind": "process", "payload": {"type": "withdraw", "amount": "2000000000"}, "payload_hex": nothing, "state": r["state"]})
    assert(starts_with(over["error"], "insufficient balance"))

test "the auditor's reports: balances, and payslips filtered by address"
    let paid be run_payroll(funded("5000000000"), ACME, [{"to": ANA, "amount": "10"}, {"to": BEN, "amount": "20"}], "2026-09")["state"]
    let all be deanonymize({"app_id": 1, "sender": ACME, "request_type": 2, "kind": "deanonymize", "payload": {}, "payload_hex": nothing, "state": paid})
    assert_eq(all["report"]["balances"][ANA], "10")
    assert_eq(all["report"]["runs"], 1)
    let ana be deanonymize({"app_id": 1, "sender": ACME, "request_type": 2, "kind": "deanonymize", "payload": {"report_type": "payslips", "address": ANA}, "payload_hex": nothing, "state": paid})
    assert_eq(length(ana["report"]["payslips"]), 1)
    assert_eq(ana["report"]["payslips"][0]["amount"], "10")

test "an unknown instruction is an error, never a silent no-op"
    let r be process({"app_id": 1, "sender": ACME, "request_type": 1, "kind": "process", "payload": {"type": "mint"}, "payload_hex": nothing, "state": company()})
    assert(starts_with(r["error"], "unsupported instruction type"))
